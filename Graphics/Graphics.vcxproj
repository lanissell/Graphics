  <!-- Puts the runtime libraries and the resources folder next to the executable, so it also starts outside of Visual Studio. -->
  <Target Name="CopyRuntimeFiles" AfterTargets="Build">
    <ItemGroup>
      <RuntimeLibrary Include="$(ExternalDir)glfw\bin\glfw3.dll;$(ExternalDir)glew\bin\glew32.dll" />
      <ResourceFile Include="$(ProjectDir)resources\**\*" Exclude="$(ProjectDir)resources\**\.gitkeep" />
    </ItemGroup>
    <Copy SourceFiles="@(RuntimeLibrary)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ResourceFile)" DestinationFiles="@(ResourceFile->'$(OutDir)resources\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
